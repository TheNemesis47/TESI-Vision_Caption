# I modelli, i default e la validazione sono definiti in:
# src/vision_caption/infrastructure/settings.py

# ---------------------------------------------------------------------------
# SERVER E RUNTIME
# ---------------------------------------------------------------------------

# true usa detector, VLM, MediaPipe e TTS simulati, senza GPU o API esterne.
# false avvia tutti i componenti reali.
USE_MOCKS=false

# Dispositivo usato da RF-DETR. Valori tipici: cuda oppure cpu.
# Non controlla MediaPipe, che usa il proprio runtime.
DEVICE=cuda

# Indirizzo di ascolto. 0.0.0.0 accetta connessioni dalla rete;
# 127.0.0.1 permette soltanto connessioni locali.
SERVER_HOST=0.0.0.0

# Porta HTTP e WebSocket. Deve essere compresa fra 1 e 65535.
SERVER_PORT=8765

# Intervallo fra i ping di keepalive inviati dal server WebSocket.
WS_PING_INTERVAL_SECONDS=300

# Tempo massimo di attesa del pong prima di chiudere la connessione.
WS_PING_TIMEOUT_SECONDS=300

# Finestra usata dal queue draining per consumare i frame già in coda e
# conservare soltanto l'ultimo. Più alto = più frame scartati ma più attesa;
# più basso = meno attesa ma maggiore rischio di processare frame vecchi.
WS_DRAIN_TIMEOUT_SECONDS=0.005

# Percorsi della chiave privata e del certificato TLS.
# WSS viene attivato soltanto se entrambi i file esistono.
SSL_KEY_PATH=key.pem
SSL_CERT_PATH=cert.pem

# Cartella dei log e livello minimo del file di log.
# Livelli tipici: DEBUG, INFO, WARNING, ERROR.
LOG_DIR=logs
LOG_LEVEL=DEBUG

# ---------------------------------------------------------------------------
# OPENROUTER / MODELLO VLM CONDIVISO
# ---------------------------------------------------------------------------

# Chiave OpenRouter. È obbligatoria quando USE_MOCKS=false.
OPENROUTER_API_KEY=

# Endpoint compatibile OpenAI. Normalmente non deve essere modificato.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modello VLM condiviso da AUTO e POINTING.
# Modelli più grandi possono essere più precisi ma più lenti e costosi.
VLM_MODEL=google/gemini-2.5-flash

# ---------------------------------------------------------------------------
# AUTO: RILEVAMENTO DEL CAMBIO CON SSIM E RF-DETR
# ---------------------------------------------------------------------------

# SSIM segnala un cambio quando score < threshold.
# Più alto = AUTO più sensibile e più cambi candidati.
# Più basso = servono differenze visive più evidenti.
SSIM_THRESHOLD=0.58

# Percorso opzionale di un checkpoint RF-DETR personalizzato.
# Se vuoto viene usato il modello COCO preaddestrato.
RFDETR_CHECKPOINT=

# Confidence minima delle detection del modello COCO standard.
# Più basso = più oggetti ma più falsi positivi; più alto = più selettivo.
RFDETR_THRESHOLD=0.60

# Confidence minima usata soltanto con RFDETR_CHECKPOINT.
RFDETR_CUSTOM_THRESHOLD=0.50

# true ottimizza RF-DETR per l'inferenza: startup più lento, inferenza
# generalmente più veloce. Impostare false in caso di incompatibilità.
RFDETR_OPTIMIZE_FOR_INFERENCE=true

# ---------------------------------------------------------------------------
# AUTO: FILTRI CHE POSSONO SOPPRIMERE UNA CAPTION
# ---------------------------------------------------------------------------

# true sopprime il cambio se classi e quantità RF-DETR sono uguali al
# keyframe precedente, anche quando gli oggetti si sono spostati.
# false descrive anche variazioni con gli stessi tipi e numeri di oggetti.
SUPPRESS_UNCHANGED_CLASS_COUNTS=true

# Intervallo minimo in secondi fra due caption AUTO.
# Più basso = caption più frequenti; più alto = meno caption.
MIN_CAPTION_INTERVAL_SECONDS=5.0

# Età massima del frame prima/durante/dopo VLM e TTS.
# Se il frame supera la soglia, caption o audio vengono scartati.
# Aumentare se nei log compaiono spesso messaggi "frame obsoleto".
MAX_FRAME_AGE_S=3.0

# La nuova caption viene scartata quando la similarità con la precedente
# supera questa soglia. Più basso = deduplicazione più aggressiva;
# più alto, ad esempio 0.95, = vengono eliminate solo frasi quasi identiche.
CAPTION_SIMILARITY_THRESHOLD=0.85

# ---------------------------------------------------------------------------
# AUTO: GENERAZIONE VLM
# ---------------------------------------------------------------------------

# Numero massimo di token della risposta AUTO.
# Aumentare se le descrizioni vengono troncate; ridurre per risposte più brevi.
AUTO_VLM_MAX_OUTPUT_TOKENS=80

# Variabilità della caption. Vicino a 0 = stabile e deterministica;
# valori più alti = testo più vario ma meno prevedibile.
AUTO_VLM_TEMPERATURE=0.1

# Timeout complessivo della richiesta HTTP AUTO verso OpenRouter.
AUTO_VLM_HTTP_TIMEOUT_SECONDS=120

# Tempo massimo di attesa per ogni nuovo chunk dello streaming VLM.
# Se scade, la caption viene interrotta per non bloccare la pipeline.
VLM_TIMEOUT_S=3.0

# ---------------------------------------------------------------------------
# POINTING: MEDIAPIPE
# ---------------------------------------------------------------------------

# Percorso del modello MediaPipe Hand Landmarker.
HAND_LANDMARKER_MODEL_PATH=models/hand_tracking/hand_landmarker.task

# Lato massimo del frame passato a MediaPipe.
# Più basso = più veloce ma meno dettaglio; 0 disabilita il ridimensionamento.
HAND_INFERENCE_MAX_SIDE=960

# Numero massimo di mani rilevate. Il WebSocket supporta più overlay.
HAND_NUM_HANDS=1

# Confidence minima per il rilevamento iniziale della mano.
# Più basso = più permissivo; più alto = più severo.
HAND_MIN_DETECTION_CONFIDENCE=0.60

# Confidence minima affinché MediaPipe consideri la mano presente.
HAND_MIN_PRESENCE_CONFIDENCE=0.60

# Confidence minima per continuare il tracking senza rilanciare il detector.
HAND_MIN_TRACKING_CONFIDENCE=0.60

# ---------------------------------------------------------------------------
# POINTING: FORMA DELLA GESTURE
# ---------------------------------------------------------------------------

# Angolo minimo dell'indice per attivare il gesto.
# Un dito completamente dritto tende a 180 gradi.
# Più alto = più severo; più basso = attivazione più facile.
POINTING_INDEX_ACTIVATION_MIN_ANGLE_DEG=145

# Angolo minimo dell'indice per mantenere una gesture già attiva.
# È più permissivo dell'attivazione per evitare oscillazioni.
POINTING_INDEX_HOLD_MIN_ANGLE_DEG=135

# Angolo massimo consentito a medio, anulare e mignolo per attivare.
# Più basso = dita obbligatoriamente più chiuse; più alto = più permissivo.
POINTING_OTHER_FINGER_ACTIVATION_MAX_ANGLE_DEG=125

# Limite più permissivo usato quando la gesture è già attiva.
POINTING_OTHER_FINGER_HOLD_MAX_ANGLE_DEG=140

# Distanza massima del pollice dal palmo, normalizzata sulla sua larghezza,
# durante l'attivazione. Più basso = pollice più vicino al palmo.
POINTING_THUMB_ACTIVATION_MAX_PALM_RATIO=1.25

# Limite del pollice più permissivo durante il mantenimento.
POINTING_THUMB_HOLD_MAX_PALM_RATIO=1.45

# ---------------------------------------------------------------------------
# POINTING: SMOOTHING E TEMPORIZZAZIONE
# ---------------------------------------------------------------------------

# Alpha EMA degli angoli delle dita.
# Più basso = più stabile ma lento; più alto = rapido ma più rumoroso.
POINTING_ANGLE_EMA_ALPHA=0.35

# Alpha EMA della posizione e direzione del raggio.
# Più basso = cono più fermo ma in ritardo; più alto = reattivo ma tremolante.
POINTING_RAY_EMA_ALPHA=0.25

# Secondi per cui la posa deve restare valida prima di diventare ACTIVE.
# Questo è il tempo durante il quale bisogna mantenere il puntamento.
POINTING_CONFIRMATION_SECONDS=0.2666666667

# Secondi di posa non valida necessari per disattivare la gesture.
# Più alto tollera perdite brevi; più basso resetta più rapidamente.
POINTING_RELEASE_SECONDS=0.1666666667

# Lunghezza minima normalizzata del segmento PIP-punta dell'indice.
# Più alto è più severo; troppo basso può produrre raggi instabili.
POINTING_MIN_VECTOR_LENGTH=0.0125

# Intervallo minimo fra due attivazioni che possono generare caption.
# Non è il tempo di conferma del gesto.
POINTING_EVENT_COOLDOWN_SECONDS=3.0

# ---------------------------------------------------------------------------
# POINTING: GEOMETRIA DEL CONO E IMMAGINI PER IL VLM
# ---------------------------------------------------------------------------

# Mezza larghezza del cono vicino alla punta del dito, espressa come
# frazione del lato corto del frame. La larghezza totale è il doppio.
POINTING_CORRIDOR_START_HALF_WIDTH_RATIO=0.008

# Mezza larghezza minima del cono sul bordo dell'immagine.
POINTING_CORRIDOR_MIN_END_HALF_WIDTH_RATIO=0.03

# Apertura proporzionale alla lunghezza del raggio.
# Più alto = cono più largo; più basso = selezione più precisa.
POINTING_CORRIDOR_EXPANSION_RATIO=0.04

# Opacità del riempimento colorato, fra 0 e 1.
# 0 = invisibile; 1 = completamente opaco.
# Vale per l'immagine context del VLM e per l'overlay frontend.
POINTING_CORRIDOR_OVERLAY_ALPHA=0.14

# Luminosità dell'area esterna al cono nell'immagine focus inviata al VLM.
# 0 = esterno nero; 1 = esterno invariato. Non modifica il frontend.
POINTING_CORRIDOR_OUTSIDE_BRIGHTNESS=0.14

# Margine aggiunto al ritaglio focus, come frazione del lato corto.
# Aumentare per fornire più contesto intorno al cono.
POINTING_CORRIDOR_CROP_PADDING_RATIO=0.025

# Qualità JPEG delle immagini context e focus inviate al VLM.
# Più alto = maggiore qualità e dimensione; intervallo valido 1-100.
POINTING_CORRIDOR_JPEG_QUALITY=90

# Colore #RRGGBB usato dal backend e comunicato al frontend.
# Le virgolette impediscono che # venga interpretato come commento.
POINTING_CORRIDOR_COLOR_HEX="#FFFF00"

# Spessore in pixel suggerito al frontend per contorno e linea centrale.
POINTING_CORRIDOR_LINE_WIDTH_PX=2

# ---------------------------------------------------------------------------
# POINTING: SALVATAGGIO DEBUG DELLE TRE IMMAGINI
# ---------------------------------------------------------------------------

# true salva, prima della chiamata OpenRouter, gli stessi tre JPEG inviati
# al VLM per ogni gesture confermata. false non crea alcun file.
# ATTENZIONE: le immagini possono contenere persone e dati sensibili.
POINTING_DEBUG_SAVE_IMAGES=false

# Cartella base dei salvataggi. Per ogni attivazione viene creata una cartella:
# frame_<id>_<timestamp>_<id-univoco>/
#   01_context_with_corridor.jpg
#   02_focus_darkened_and_cropped.jpg
#   03_clean_original.jpg
POINTING_DEBUG_OUTPUT_DIR=artifacts/pointing_debug

# ---------------------------------------------------------------------------
# POINTING: VLM
# ---------------------------------------------------------------------------

# Timeout complessivo della richiesta OpenRouter POINTING.
POINTING_VLM_TIMEOUT_SECONDS=30

# Limite massimo della risposta JSON. Troppo basso può troncare il JSON.
POINTING_VLM_MAX_OUTPUT_TOKENS=1200

# Variabilità della risposta POINTING. Tenerla bassa rende il JSON più stabile.
POINTING_VLM_TEMPERATURE=0.1

# ---------------------------------------------------------------------------
# TTS: ELEVENLABS
# ---------------------------------------------------------------------------

# Se valorizzata viene usato ElevenLabs; se vuota si usa Chatterbox.
ELEVENLABS_API_KEY=

# Identificativo della voce ElevenLabs.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Modello di sintesi ElevenLabs.
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Timeout della chiamata HTTP ElevenLabs.
ELEVENLABS_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# TTS: CHATTERBOX LOCALE
# ---------------------------------------------------------------------------

# URL del servizio Chatterbox locale usato come fallback.
CHATTERBOX_URL=http://localhost:4123

# Timeout massimo della generazione audio Chatterbox.
CHATTERBOX_TIMEOUT_SECONDS=120

# Nome o identificativo della voce inviato al servizio.
CHATTERBOX_VOICE=alloy

# Velocità del parlato. Maggiore di 1 accelera; minore di 1 rallenta.
CHATTERBOX_SPEED=1.0

# Intensità/espressività. Più alto produce normalmente maggiore enfasi.
CHATTERBOX_EXAGGERATION=0.7

# Peso del conditioning: più alto segue più rigidamente voce e stile,
# ma valori eccessivi possono ridurre la naturalezza.
CHATTERBOX_CFG_WEIGHT=0.4

# Variabilità della sintesi. Più basso = stabile; più alto = più variazione.
CHATTERBOX_TEMPERATURE=0.9
